FROM oven/bun:1 AS base
WORKDIR /app

FROM base AS pruner
COPY . .
RUN bunx turbo prune http-server --docker

FROM base AS installer
WORKDIR /app
ENV NODE_ENV=production

# `prisma generate` loads packages/db/prisma.config.ts, which strictly requires
# DIRECT_DATABASE_URL, but generation never opens a database connection.
# A build-only placeholder keeps the image build hermetic; the real value is
# injected at runtime by Docker Compose for `prisma migrate deploy`.
# This never reaches the runner stage, which starts from a fresh base image.
ENV DIRECT_DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build"

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/bun.lock ./bun.lock

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

COPY --from=pruner /app/out/full/ .

RUN bun run db:generate
RUN bun run build:http

# The production install recreates node_modules, which also removes the
# generated Prisma Client, so regenerate it after pruning dev dependencies.
RUN rm -rf node_modules && \
    bun install --production --frozen-lockfile && \
    bun run db:generate && \
    bunx --no-install prisma --version && \
    bun run --cwd=packages/db prisma:migrate:deploy --help

FROM oven/bun:1-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy only runtime dependencies and built dist output
COPY --from=installer /app/node_modules ./node_modules
COPY --from=installer /app/apps/http-server/dist ./apps/http-server/dist
COPY --from=installer /app/apps/http-server/package.json ./apps/http-server/package.json
# The migration Compose service uses this image, so include the database
# package's Prisma configuration, schema, and migration history at runtime.
COPY --from=installer /app/packages/db/package.json ./packages/db/package.json
COPY --from=installer /app/packages/db/prisma.config.ts ./packages/db/prisma.config.ts
COPY --from=installer /app/packages/db/prisma ./packages/db/prisma

EXPOSE 4000
CMD ["bun", "--no-env-file", "./apps/http-server/dist/index.js"]
