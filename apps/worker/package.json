{
  "name": "worker",
  "module": "src/workers/generation.worker.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env.local --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun ./dist/index.js",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@repo/common": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/infrastructure": "workspace:*",
    "@repo/ports": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/types": "workspace:*",
    "@types/nodemailer": "^8.0.1",
    "bullmq": "^5.79.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3"
  }
}