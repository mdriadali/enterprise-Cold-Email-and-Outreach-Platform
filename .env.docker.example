# Web & API Application Configuration
APP_NAME="Cold Out Reach"
HTTP_SERVER_URL=http://http-server:4000/api/v1/
APP_URL=http://localhost:3000

# PostgreSQL Database Configuration (Internal Docker Compose Service)
DATABASE_URL=postgresql://postgres:mypassword@postgres:5432/coldMailAndOutrech
DIRECT_DATABASE_URL=postgresql://postgres:mypassword@postgres:5432/coldMailAndOutrech

# HTTP Server
HTTP_PORT=4000

# Authentication (JWT Secrets - replace with secure strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Redis Queue & Cache Configuration (Internal Docker Compose Service)
REDIS_URL=redis://redis:6379

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=none
MAIL_FROM="Cold Out Reach <no-reply@localhost>"

# Logging & Environment
NODE_ENV=development
LOG_LEVEL=info
