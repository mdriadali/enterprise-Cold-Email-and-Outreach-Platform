name: Deploy the web

on: 
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout the code
        uses: actions/checkout@v4

      - name: Docker login
        uses: docker/login-action@v2
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_PASSWORD }}

      - name: Build and push
        uses: docker/build-push-action@v4
        with:
          context: .
          file: ./apps/web/Dockerfile
          build-args: |
            APP_NAME=${{secrets.APP_NAME}}
            HTTP_SERVER_URL=${{secrets.HTTP_SERVER_URL}}
          push: true
          tags: riadofficial/enterprise-cold-email-and-outreach-platform-web:${{ github.sha }}
      
