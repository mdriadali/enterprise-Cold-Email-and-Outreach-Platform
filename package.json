{
  "name": "enterprise-Cold-Email-and-Outreach-Platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",

    "db:migrate": "bun --env-file=.env.local -- prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "bunx prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:generate": "bunx prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:push": "bunx prisma db push --schema=packages/db/prisma/schema.prisma",

    "build:web": "turbo run build --filter=web",
    "start:web": "turbo run start --filter=web",

    "build:http": "turbo run build --filter=http-server",
    "start:http": "turbo run start --filter=http-server",

    "build:worker": "turbo run build --filter=worker",
    "start:worker": "turbo run start --filter=worker"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "zod": "^4.4.3"
  }
}