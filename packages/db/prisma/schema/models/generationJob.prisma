model GenerationJob {
  id           String              @id @default(uuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  status       GenerationJobStatus @default(PENDING)
  errorMessage String?

  lead Lead[]

  successCount Int?
  failedCount  Int?
  pendingCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}
